<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DebugType>embedded</DebugType>
        <AssemblyName>Light</AssemblyName>
        <RootNamespace>Light</RootNamespace>

        <VersionPrefix>1.0.0</VersionPrefix>
        <VersionSuffix>dev</VersionSuffix>
        <Description>Light In The Dark - Among Us Mod</Description>
        <AmongUs Condition="'$(LIGHT_AMONGUS)' != ''">$(LIGHT_AMONGUS)</AmongUs>
        <AmongUs Condition="'$(LIGHT_AMONGUS)' == ''">F:\AU\暗中辉0.0.0.1</AmongUs>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\**\*.*" />

        <Compile Remove="UI\Window\GUIWidgetHelpers.cs" />

        <Compile Remove="UI\Window\MetaUI.cs" />
        <Compile Remove="UI\Window\MetaScreen.cs" /><Compile Remove="UI\Window\Widgets.cs" /><Compile Remove="UI\Window\LIDGUI.cs" /><Compile Remove="UI\Window\GUIScrollView.cs" />
        <Compile Remove="UI\Nova\**\*.cs" />
        
    </ItemGroup>

    <ItemGroup><Compile Remove="UI\Window\GUIWidgetHelpers.cs" />

        <Compile Remove="UI\Window\MetaUI.cs" />
        <Compile Remove="UI\Window\MetaScreen.cs" /><Compile Remove="UI\Window\Widgets.cs" /><Compile Remove="UI\Window\LIDGUI.cs" /><Compile Remove="UI\Window\GUIScrollView.cs" />



<Compile Remove="UI\Nova\**\*.cs" />
    </ItemGroup>

	<PropertyGroup Condition="$(TargetFramework.Contains('android'))">
		<DefineConstants>$(DefineConstants);ANDROID</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
	  <!-- 2026-10-25 移除：这是 2026-10-02 的**备份文件**（NOS 原版代码），不该参与编译 ✗
       它引用了 NebulaRPCHolder / DefinedSingleAbilityRoleTemplate / HasCitation 等 NOS 类型 → 88 个 CS0246 ✓
       真正的新职业请写在 Roles\Impostors\Camouflager.cs（不带 1）✓ -->
	</ItemGroup>
    <ItemGroup>
      <Folder Include="Components\" />
      <Folder Include="Resources\News\" />
      <Folder Include="Systems\" />
    
    </ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\LightAPI\LightInDark.csproj" />
    
	</ItemGroup>
    <Target Name="AddGameReferences" BeforeTargets="ResolveAssemblyReferences">
        <ItemGroup>
            <_LibDlls Include="..\Libs\*.dll" Exclude="..\Libs\netstandard.dll" />
            <Reference Include="@(_LibDlls->'%(FileName)')">
                <HintPath>%(FullPath)</HintPath>
                <Private>false</Private>
            </Reference>
    
        </ItemGroup>
    </Target>
	<PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
		<DefineConstants>WINDOWS</DefineConstants>
	</PropertyGroup>
	<Target Name="CustomCopyToOutput" AfterTargets="Build">
		<PropertyGroup>
			<CustomOutDir>$(ProjectDir)..\Output\</CustomOutDir>
		</PropertyGroup>
		<MakeDir Directories="$(CustomOutDir)" Condition="!Exists('$(CustomOutDir)')" />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CustomOutDir)" />

		<ItemGroup>
			<_ApiDllFromRef Include="@(ReferencePath)" Condition="'%(Filename)' == 'LightInDark'" />
    
		</ItemGroup>
		<Copy SourceFiles="@(_ApiDllFromRef)" DestinationFolder="$(CustomOutDir)" Condition="'@(_ApiDllFromRef)' != ''" SkipUnchangedFiles="true" />

		<Copy SourceFiles="$(ProjectDir)..\Libs\LightInDark.dll" DestinationFolder="$(CustomOutDir)" Condition="Exists('$(ProjectDir)..\Libs\LightInDark.dll')" SkipUnchangedFiles="true" />

		<Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(CustomOutDir)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />

		<Message Importance="high" Text="[Output] Light.dll + LightInDark.dll → $(CustomOutDir)" />
	</Target>
    
</Project>