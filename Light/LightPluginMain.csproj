<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DebugType>embedded</DebugType>
        <AssemblyName>Light</AssemblyName>
        <RootNamespace>Light</RootNamespace>

        <VersionPrefix>1.0.0</VersionPrefix>
        <VersionSuffix>dev</VersionSuffix>
        <Description>Light In The Dark - Among Us Mod</Description>
        <AmongUs Condition="'$(LIGHT_AMONGUS)' != ''">$(LIGHT_AMONGUS)</AmongUs>
        <AmongUs Condition="'$(LIGHT_AMONGUS)' == ''">F:\AU\暗中辉0.0.0.1</AmongUs>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\**\*.*" />
    </ItemGroup>

	<PropertyGroup Condition="$(TargetFramework.Contains('android'))">
		<DefineConstants>$(DefineConstants);ANDROID</DefineConstants>
	</PropertyGroup>
    <ItemGroup>
      <Folder Include="Systems\" />
    </ItemGroup>

    <Target Name="AddGameReferences" BeforeTargets="ResolveAssemblyReferences">
        <ItemGroup>
            <_LibDlls Include="..\Libs\*.dll" Exclude="..\Libs\netstandard.dll" />
            <Reference Include="@(_LibDlls->'%(FileName)')">
                <HintPath>%(FullPath)</HintPath>
                <Private>false</Private>
            </Reference>
        </ItemGroup>
    </Target>
	<PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
		<DefineConstants>WINDOWS</DefineConstants>
	</PropertyGroup>
	<Target Name="CustomCopyToOutput" AfterTargets="Build">
		<PropertyGroup>
			<CustomOutDir>$(ProjectDir)..\Output\</CustomOutDir>
		</PropertyGroup>
		<MakeDir Directories="$(CustomOutDir)" Condition="!Exists('$(CustomOutDir)')" />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CustomOutDir)" />
		<Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(CustomOutDir)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />

		<!-- 单独构建本插件时，也把 API 产物复制到 Output -->
		<Copy SourceFiles="$(ProjectDir)..\Libs\LightInDark.dll" DestinationFolder="$(CustomOutDir)" Condition="Exists('$(ProjectDir)..\Libs\LightInDark.dll')" />

		<ItemGroup>
			<FilteredDependencies Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'Light' OR '%(Filename)' == 'LightInDark'" />
		</ItemGroup>
		<Copy SourceFiles="@(FilteredDependencies)" DestinationFolder="$(CustomOutDir)" />
	</Target>
</Project>